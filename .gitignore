# ============================================================================
# RrcCodec 版本控制忽略规则
#
# 原则：
#   1. 只忽略“本机构建/运行期产物”和“IDE/OS 私有文件”；
#   2. 生成物（include/rrc_codec/types/rrc_types.h、
#      include/rrc_codec/messages/rrc_messages.h、src/generated/*.cpp、
#      generated/ 下的统计与索引）按仓库约定“入库”，因此不得忽略；
#   3. 路径以 / 开头者只匹配仓库根目录，避免误伤同名子目录。
# ============================================================================

# ---------------------------------------------------------------------------
# 构建目录与 CMake 产物
# ---------------------------------------------------------------------------
/build/
/build-*/
/build_*/
/cmake-build-*/
/cmake-build_*/
/out/
/install/
/prefix/
/artifacts/
/tmp/
/_deps/
CMakeUserPresets.json

CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
compile_commands.json
Makefile
*.cbp
*.layout
*.stackdump
Testing/

# ---------------------------------------------------------------------------
# 编译/链接产物
# ---------------------------------------------------------------------------
*.o
*.obj
*.lo
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exp
*.pdb
*.ilk
*.idb
*.exe
*.out
*.dSYM/
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata
*.lto
*.mod
*.smod

# ---------------------------------------------------------------------------
# Python（rrcgen 为开发期工具）
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
env/
*.egg-info/
dist/
.tools-venv/

# ---------------------------------------------------------------------------
# IDE / 编辑器
# ---------------------------------------------------------------------------
.idea/
.vscode/
.vs/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
.cache/
.clangd/
.envrc

# ---------------------------------------------------------------------------
# 本地目录（不入库）
# ---------------------------------------------------------------------------
/docs/

# ---------------------------------------------------------------------------
# 操作系统与临时文件
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
*.swp
*.swo
*~
*.tmp
*.bak
*.log
