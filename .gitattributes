# ============================================================================
# RrcCodec Git 属性
#
# 目标：
#   1. 文本文件在仓库内统一为 LF，保证跨平台（Windows/Linux/macOS）逐字节一致；
#   2. Windows 专有脚本（.bat/.cmd/.ps1）检出为 CRLF，便于本机直接运行；
#   3. 二进制文件不做文本转换，避免损坏；
#   4. 生成物打上 linguist-generated 标记，评审时默认折叠 diff。
# ============================================================================

# 未显式声明的文件：按内容自动识别文本，仓库内统一 LF
* text=auto eol=lf

# ---------------------------------------------------------------------------
# 文本文件：明确 LF（覆盖 * text=auto 的自动判断）
# ---------------------------------------------------------------------------
*.c            text eol=lf
*.h            text eol=lf
*.cpp          text eol=lf
*.hpp          text eol=lf
*.cc           text eol=lf
*.hh           text eol=lf
*.ipp          text eol=lf
*.inl          text eol=lf
*.py           text eol=lf
*.pyi          text eol=lf
*.cmake        text eol=lf
CMakeLists.txt text eol=lf
*.cmake.in     text eol=lf
*.pc.in        text eol=lf
*.json         text eol=lf
*.json5        text eol=lf
*.yaml         text eol=lf
*.yml          text eol=lf
*.toml         text eol=lf
*.md           text eol=lf
*.txt          text eol=lf
*.asn          text eol=lf
*.sha256       text eol=lf
*.in           text eol=lf
*.gitignore    text eol=lf
*.gitattributes text eol=lf
LICENSE        text eol=lf
Makefile       text eol=lf
*.mk           text eol=lf

# Windows 脚本：检出为 CRLF
*.bat          text eol=crlf
*.cmd          text eol=crlf
*.ps1          text eol=crlf
*.vcxproj      text eol=crlf
*.sln          text eol=crlf

# ---------------------------------------------------------------------------
# 二进制文件：禁止文本转换与行尾归一
# ---------------------------------------------------------------------------
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
*.pdf          binary
*.zip          binary
*.gz           binary
*.7z           binary
*.tar          binary
*.bin          binary
*.dat          binary
*.der          binary
*.lib          binary
*.dll          binary
*.exe          binary
*.pdb          binary
*.o            binary
*.a            binary
*.so           binary
*.dylib        binary

# ---------------------------------------------------------------------------
# 生成物标记（内容仍是文本，仅提示评审/统计工具）
# ---------------------------------------------------------------------------
include/rrc_codec/types/rrc_types.h        linguist-generated=true
include/rrc_codec/types/rrc_types_part*.h   linguist-generated=true
include/rrc_codec/messages/rrc_messages.h  linguist-generated=true
src/generated/**                            linguist-generated=true
generated/**                                linguist-generated=true
